# Copy to backend/.env and fill in TMDB_READ_TOKEN. Never commit .env.

# TMDb "API Read Access Token" (v4 bearer). Not the short v3 API key.
TMDB_READ_TOKEN=

# Random secret for session tokens and recovery-code hashing: openssl rand -hex 32
# Changing it logs everyone out and invalidates unused recovery codes.
JWT_SECRET=

# Database (local docker-compose MySQL). On the cluster these come from Doppler.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=debarras
DB_USER=debarras
DB_PASSWORD=
# Only for local compose / first-time DB creation. Leave unset on the cluster.
DB_ROOT_PASSWORD=

# Passkeys: the domain the frontend is served from, and its full origin(s).
# Production: debarras.sacenpapier.org and https://debarras.sacenpapier.org
# Passkeys are bound to this domain: do not change it after launch.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3002,http://localhost:5173

# Optional
# CORS_ORIGINS=http://localhost:3002,http://localhost:5173
# TMDB_RPS=30
# CACHE_TTL_DAYS=7
# WIKI_USER_AGENT=Debarras/1.0 (https://debarras.sacenpapier.org; contact@example.org)
